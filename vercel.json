{
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "app.py",
        "controllers/**",
        "models/**",
        "services/**",
        "views/**",
        "insumos/**"
      ],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
